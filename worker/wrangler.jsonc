{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dog-measurement-email-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "DELIVERY_MODE": "live",
    "EMAIL_SUBJECT": "New measurement request",
    "ALLOWED_ORIGINS": "https://your-github-username.github.io,https://www.example.com"
  },
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["RESEND_API_KEY", "TURNSTILE_SECRET_KEY", "RECIPIENT_EMAIL", "SENDER_EMAIL"]
  },
  "env": {
    "dev": {
      "name": "dog-measurement-email-api-dev",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "DELIVERY_MODE": "mock",
        "EMAIL_SUBJECT": "[DEV] New measurement request",
        "ALLOWED_ORIGINS": "http://127.0.0.1:8765,http://localhost:8765"
      },
      "ratelimits": [
        {
          "name": "SUBMISSION_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 3,
            "period": 60
          }
        }
      ],
      "secrets": {
        "required": ["TURNSTILE_SECRET_KEY"]
      }
    }
  }
}
